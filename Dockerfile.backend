# Backend Dockerfile — FastAPI + sentence-transformers
# Build context must be the project root (needs backend/ + requirements.txt)

FROM python:3.12-slim

# System deps for some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (cached layer — only rebuilds when requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

# Copy backend code
COPY backend/ ./backend/

# The app expects this directory structure:
#   /app/backend/src/api/app.py  (the FastAPI app)
#   /app/data/processed/         (mounted at runtime)
# PROJECT_ROOT resolves to /app/ via parent traversal from routes/

ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Match the same command run_server.py uses
CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]